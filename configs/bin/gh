#!/bin/sh
# ~/.local/bin/gh — managed by ~/dotfiles (configs/bin/gh)
#
# Inside ~/Work, run gh as the work account. ~/Work/.envrc already does this
# for terminals, but GUI apps (T3 Code, IDEs) snapshot the shell env once at
# launch and never run direnv, so their gh would fall back to the active
# (personal) account. An explicit GH_TOKEN/GITHUB_TOKEN still wins.
# Outside ~/Work the work token is dropped (see below).
real=/opt/homebrew/bin/gh

work_token() { "$real" auth token --user JoaoPedroSedrezPX 2>/dev/null; }

case "$PWD/" in
  "$HOME"/[Ww]ork/*)
    if [ -z "$GH_TOKEN$GITHUB_TOKEN" ]; then
      GH_TOKEN=$(work_token) && export GH_TOKEN
    fi
    ;;
  *)
    # A work token leaked from a shell that started in ~/Work (direnv
    # exports it there) shouldn't follow you out; any other token is kept.
    if [ -n "$GITHUB_TOKEN" ] && [ "$GITHUB_TOKEN" = "$(work_token)" ]; then
      unset GITHUB_TOKEN
    fi
    ;;
esac

exec "$real" "$@"
