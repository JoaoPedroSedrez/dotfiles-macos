[user]
	name = João Pedro Sedrez
	email = sedrez.jp2@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	# Ayu from configs/bat/themes, registered by `bat cache --build`.
	syntax-theme = ayu-dark

# `gitdir:` matches case-sensitively even on a case-insensitive filesystem,
# so the pattern has to be `/i` or spelled exactly like the directory (~/Work).
[includeIf "gitdir/i:~/work/"]
	path = ~/dotfiles/configs/git/work.gitconfig

# Commit signing with a Secretive SSH key, off by default. Setup in
# docs/secretive.md.
# [user]
# 	signingkey = key::CHANGEME
# [gpg]
# 	format = ssh
# [commit]
# 	gpgsign = true

# px-center repos go over HTTPS so they authenticate with the work gh token
# that ~/Work/.envrc exports, even when cloned with a git@github.com: URL.
# Lives here (not work.gitconfig) because includeIf gitdir doesn't match
# during `git clone`, before the repo exists.
[url "https://github.com/px-center/"]
	insteadOf = git@github.com:px-center/
	insteadOf = ssh://git@github.com/px-center/

[credential "https://github.com"]
	helper = 
	helper = !~/dotfiles/configs/git/gh-credential
	useHttpPath = true
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
