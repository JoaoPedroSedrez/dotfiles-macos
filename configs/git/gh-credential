#!/bin/sh
# git credential helper for github.com — managed by ~/dotfiles
# (configs/git/gh-credential, wired up in configs/git/gitconfig).
#
# Picks the gh account by repo owner instead of by shell env, so it works
# the same from a terminal, T3 Code or an IDE: px-center/* uses the work
# account, everything else goes through `gh auth git-credential` (the
# active account, or GITHUB_TOKEN when ~/Work/.envrc set it). Needs
# credential.useHttpPath so git passes the repo path.
gh=/opt/homebrew/bin/gh
input=$(cat)

if [ "$1" = get ]; then
  case "$(printf '%s\n' "$input" | sed -n 's/^path=//p')" in
    px-center/*)
      token=$("$gh" auth token --user JoaoPedroSedrezPX 2>/dev/null) || exit 0
      printf 'username=JoaoPedroSedrezPX\npassword=%s\n' "$token"
      exit 0
      ;;
  esac
fi

printf '%s\n' "$input" | exec "$gh" auth git-credential "$@"
